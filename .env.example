# Doctor Office Intelligent System - Environment Configuration
# Copy this file to .env and adjust values as needed.
# NEVER commit .env to version control.

# ============================================================
# LLM SETTINGS (OpenAI-compatible API)
# ============================================================
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=qwen2.5:1.5b

# Token limits per mode
LLM_FAST_MAX_TOKENS=384
LLM_QUALITY_MAX_TOKENS=384

# ============================================================
# RAG SETTINGS
# ============================================================
RAG_TOP_K=2

# ============================================================
# SAFETY GUARD: ALLOW_REAL_PHI
# ============================================================
# Setting this to true disables the synthetic-data guard.
# Only do this in an isolated dev environment with synthetic data you control.
ALLOW_REAL_PHI=false